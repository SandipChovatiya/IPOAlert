{
  "name": "ipo-alert",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "agents": "tsx --env-file=.env.local agents/scheduler.ts",
    "agent:sync": "tsx --env-file=.env.local agents/run.ts sync",
    "agent:status": "tsx --env-file=.env.local agents/run.ts status",
    "agent:summarize": "tsx --env-file=.env.local agents/run.ts summarize",
    "agent:all": "tsx --env-file=.env.local agents/run.ts all",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@libsql/client": "^0.18.0",
    "next": "16.4.3",
    "node-cron": "^4.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
